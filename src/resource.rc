#include <windows.h>
#include "resource.h"

// 图标
IDI_ICON1 ICON "GUIC_2.0.ico"

/////////////////////////////////////////////////////////////////////////////
// 对话框资源
/////////////////////////////////////////////////////////////////////////////

// 设置提示信息对话框
IDD_MESSAGE_DIALOG DIALOGEX 0, 0, 300, 180
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "设置提示信息"
FONT 9, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    LTEXT           "请输入提示信息：", IDC_STATIC, 10, 10, 260, 20
    EDITTEXT        IDC_EDIT_MESSAGE, 10, 35, 260, 70, ES_MULTILINE | ES_WANTRETURN | WS_VSCROLL
    DEFPUSHBUTTON   "确定", IDOK, 85, 115, 60, 25
    PUSHBUTTON      "取消", IDCANCEL, 155, 115, 60, 25
END

// 设置一次性倒计时对话框
IDD_COUNTDOWN_ONCE_DIALOG DIALOGEX 0, 0, 300, 130
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "设置一次性倒计时"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT           "请输入目标时间(YYYY-MM-DD HH:MM:SS)：", IDC_STATIC, 10, 10, 260, 20
    EDITTEXT        IDC_EDIT_ONCE_TIME, 10, 35, 260, 22
    DEFPUSHBUTTON   "确定", IDOK, 85, 70, 60, 25
    PUSHBUTTON      "取消", IDCANCEL, 155, 70, 60, 25
END

// 设置每日倒计时对话框
IDD_COUNTDOWN_DAILY_DIALOG DIALOGEX 0, 0, 380, 230
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "设置每日倒计时"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT           "请输入每日时间(HH:MM:SS):", IDC_STATIC, 10, 10, 200, 20
    EDITTEXT        IDC_EDIT_DAILY_TIME, 10, 35, 330, 22
    LTEXT           "备注:", IDC_STATIC, 10, 65, 30, 20
    EDITTEXT        IDC_EDIT_DAILY_REMARK, 10, 90, 330, 60, ES_MULTILINE | WS_VSCROLL
    DEFPUSHBUTTON   "确定", IDOK, 215, 160, 60, 25
    PUSHBUTTON      "取消", IDCANCEL, 285, 160, 60, 25
END

// 窗口设置对话框
IDD_WINDOW_SETTINGS_DIALOG DIALOGEX 0, 0, 330, 215
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "窗口设置"
FONT 9, "MS Shell Dlg"
BEGIN
    AUTOCHECKBOX    "允许调整窗口大小", IDC_CHECK_RESIZABLE, 20, 25, 150, 22
    LTEXT           "窗口大小:", IDC_STATIC, 10, 55, 80, 22
    LTEXT           "宽度:", IDC_STATIC, 20, 80, 40, 22
    EDITTEXT        IDC_EDIT_WINDOW_WIDTH, 60, 78, 60, 22
    LTEXT           "高度:", IDC_STATIC, 140, 80, 40, 22
    EDITTEXT        IDC_EDIT_WINDOW_HEIGHT, 180, 78, 60, 22
    LTEXT           "范围: 宽度300-2000, 高度200-1500", IDC_STATIC, 20, 110, 260, 22
    DEFPUSHBUTTON   "确定", IDOK, 85, 145, 60, 25
    PUSHBUTTON      "取消", IDCANCEL, 155, 145, 60, 25
END

// 字体设置对话框
IDD_FONT_SETTINGS_DIALOG DIALOGEX 0, 0, 260, 160
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "字体设置"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT           "字体大小:", IDC_STATIC, 20, 35, 60, 22
    EDITTEXT        IDC_EDIT_FONT_SIZE, 85, 33, 60, 22
    LTEXT           "字体名称:", IDC_STATIC, 20, 65, 60, 22
    EDITTEXT        IDC_EDIT_FONT_NAME, 85, 63, 120, 22
    DEFPUSHBUTTON   "确定", IDOK, 70, 100, 60, 25
    PUSHBUTTON      "取消", IDCANCEL, 140, 100, 60, 25
END

// 颜色设置对话框
IDD_COLOR_SETTINGS_DIALOG DIALOGEX 0, 0, 240, 140
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "颜色设置"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT           "请选择字体颜色:", IDC_STATIC, 10, 10, 150, 22
    PUSHBUTTON      "选择颜色", IDC_BUTTON_COLOR, 10, 35, 100, 25
    DEFPUSHBUTTON   "确定", IDOK, 45, 75, 60, 25
    PUSHBUTTON      "取消", IDCANCEL, 115, 75, 60, 25
END

// 添加特殊日子对话框
IDD_SPECIAL_DAY_DIALOG DIALOGEX 0, 0, 380, 280
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "添加特殊日子"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT           "名称:", IDC_STATIC, 10, 10, 40, 22
    EDITTEXT        IDC_EDIT_NAME, 55, 8, 280, 22
    LTEXT           "月份:", IDC_STATIC, 10, 40, 40, 22
    EDITTEXT        IDC_EDIT_MONTH, 55, 38, 60, 22, ES_NUMBER
    LTEXT           "日期:", IDC_STATIC, 130, 40, 40, 22
    EDITTEXT        IDC_EDIT_DAY, 175, 38, 60, 22, ES_NUMBER
    AUTOCHECKBOX    "每年重复", IDC_CHECK_ANNUAL, 10, 70, 90, 22
    LTEXT           "年份:", IDC_STATIC, 120, 70, 40, 22
    EDITTEXT        IDC_EDIT_YEAR, 165, 68, 70, 22, ES_NUMBER
    AUTOCHECKBOX    "节气", IDC_CHECK_SOLAR_TERM, 10, 100, 60, 22
    LTEXT           "时间:", IDC_STATIC, 90, 100, 40, 22
    EDITTEXT        IDC_EDIT_HOUR, 130, 98, 50, 22, ES_NUMBER
    LTEXT           ":", IDC_STATIC, 185, 100, 10, 22
    EDITTEXT        IDC_EDIT_MINUTE, 195, 98, 50, 22, ES_NUMBER
    DEFPUSHBUTTON   "确定", IDOK, 140, 210, 60, 25
    PUSHBUTTON      "取消", IDCANCEL, 210, 210, 60, 25
END

// 预览提示信息对话框
IDD_PREVIEW_MESSAGE_DIALOG DIALOGEX 0, 0, 380, 210
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "预览提示信息"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT           "当前提示信息:", IDC_STATIC, 10, 10, 150, 22
    EDITTEXT        IDC_EDIT_PREVIEW_MESSAGE, 10, 35, 330, 100, ES_MULTILINE | WS_VSCROLL | ES_READONLY
    DEFPUSHBUTTON   "确定", IDOK, 120, 145, 60, 25
    PUSHBUTTON      "取消", IDCANCEL, 190, 145, 60, 25
END

// 世界时钟对话框
IDD_WORLD_CLOCK_DIALOG DIALOGEX 0, 0, 320, 290
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "世界时钟"
FONT 9, "MS Shell Dlg"
BEGIN
    LISTBOX         IDC_LIST_WORLD_CLOCKS, 10, 10, 280, 150, WS_VSCROLL | WS_BORDER | LBS_NOTIFY
    LTEXT           "", IDC_STATIC_WORLD_CLOCK_DISPLAY, 10, 170, 280, 50, SS_CENTER
    DEFPUSHBUTTON   "关闭", IDOK, 240, 230, 50, 25
END

// 模拟时钟对话框
IDD_ANALOG_CLOCK_DIALOG DIALOGEX 0, 0, 320, 350
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "模拟时钟"
FONT 9, "MS Shell Dlg"
BEGIN
    CONTROL         "", IDC_STATIC_ANALOG_CLOCK, "STATIC", SS_OWNERDRAW, 10, 25, 280, 240
    DEFPUSHBUTTON   "关闭", IDOK, 240, 275, 50, 25
END
